# resona-ai-be — copy to .env
#   cp .env.example .env

PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/resona
REDIS_URL=redis://127.0.0.1:6379

JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me

# Comma-separated frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Used when generating employee join links
EMPLOYEE_APP_URL=http://localhost:3001

# Optional — Describe Session chatbot (heuristic fallback if empty)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
