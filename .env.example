# resona-ai-be — copy to .env
#   cp .env.example .env

PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/resona
REDIS_URL=redis://127.0.0.1:6379

JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me

# Comma-separated frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Used when generating employee join links
EMPLOYEE_APP_URL=http://localhost:3001

# Optional — Describe Session chatbot (heuristic fallback if empty)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Knowledge base document uploads (GridFS). Optional — defaults shown below.
# Max size per upload, in bytes (default: 2MB)
KB_MAX_UPLOAD_BYTES=2097152
# Comma-separated allowed MIME types (default: text/plain,text/markdown,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document)
KB_ALLOWED_MIME_TYPES=text/plain,text/markdown,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# PDF/DOCX extraction resource limits. Optional — defaults shown below.
# Max PDF page count (default: 300)
KB_MAX_PDF_PAGES=300
# Max extracted text characters per document, PDF or DOCX (default: 5000000)
KB_MAX_EXTRACTED_CHARS=5000000
# Wall-clock bound on a single extraction call, in ms (default: 15000). See
# knowledge-document-extraction.util.ts for why this bounds wait time only,
# not actual CPU consumption by a pathological file.
KB_EXTRACTION_TIMEOUT_MS=15000
# DOCX (ZIP) structural pre-check, applied before any decompression:
KB_MAX_DOCX_ZIP_ENTRIES=2000
KB_MAX_DOCX_ENTRY_BYTES=104857600
KB_MAX_DOCX_TOTAL_BYTES=209715200
KB_MAX_DOCX_COMPRESSION_RATIO=300

# Approved web-page ingestion. Optional — defaults shown below. HTTPS only;
# there is no exception mechanism for HTTP. See web-ssrf-guard.util.ts /
# web-fetch.util.ts for the full SSRF defense design.
KB_WEB_MAX_REDIRECTS=3
KB_WEB_MAX_RESPONSE_BYTES=5242880
KB_WEB_FETCH_TIMEOUT_MS=15000
KB_WEB_MAX_EXTRACTED_CHARS=2000000

# Hybrid (keyword + semantic) retrieval top-k. Optional (default: 4, hard
# ceiling 10 regardless of this value). Semantic scoring itself reuses
# OPENAI_API_KEY above (via src/ai/embedding) — with no API key set,
# retrieval is keyword-only and this still just caps how many chunks are
# returned. See knowledge-base.service.ts's class doc for the full
# hybrid-retrieval design, scale limits, and upgrade path.
KB_RETRIEVAL_TOP_K=4
